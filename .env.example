# Toutes les variables sont optionnelles : ARISE fonctionne en local sans aucune configuration.

# IA (photo de repas, coach, rapport hebdo). Sans clé serveur, chaque utilisateur
# peut saisir sa propre clé dans Réglages → IA.
ANTHROPIC_API_KEY=
# Code exigé par les routes IA (recommandé si l'app est publique avec une clé serveur).
ARISE_ACCESS_CODE=
# Modèle Claude (défaut : claude-opus-5-5).
ARISE_AI_MODEL=

# Compte + synchronisation multi-appareils (voir supabase/migrations/0001_init.sql).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
